{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triumph-automations",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "env": {
    "production": {
      "name": "triumph-automations-production",
      "workers_dev": true,
      "ai": {"binding":"AI"},
      "vars": {
        "ENVIRONMENT": "production",
        "PLATFORM_ENABLED": "false",
        "PLATFORM_AI_ENABLED": "false",
        "PLATFORM_WHATSAPP_ENABLED": "false",
        "PLATFORM_BILLING_TEST_ENABLED": "false",
        "CHAT_ENABLED": "true",
        "CHAT_PROVIDER": "workers_ai",
        "CHAT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
        "REPORTS_EMAIL_ENABLED": "true",
        "BOOKING_ENABLED": "true",
        "BOOKING_SMS_ENABLED": "false",
        "BOOKING_WHATSAPP_ENABLED": "false",
        "OWNER_EMAIL": "admin@triumphantech.com",
        "EMAIL_FROM": "TriumphantTech <hello@notify.triumphantech.com>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "triumph_db",
          "database_id": "72f0af83-6643-426d-ac2e-c7b99e96fe0f",
          "migrations_dir": "migrations",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
    "staging": {
      "name": "triumph-automations-staging",
      "workers_dev": true,
      "ai": {"binding":"AI"},
      "vars": {
        "ENVIRONMENT": "staging",
        "PLATFORM_ENABLED": "true",
        "PLATFORM_AI_ENABLED": "true",
        "PLATFORM_WHATSAPP_ENABLED": "false",
        "PLATFORM_BILLING_TEST_ENABLED": "false",
        "CHAT_ENABLED": "true",
        "CHAT_PROVIDER": "workers_ai",
        "CHAT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
        "REPORTS_EMAIL_ENABLED": "false",
        "BOOKING_ENABLED": "true",
        "BOOKING_SMS_ENABLED": "false",
        "BOOKING_WHATSAPP_ENABLED": "false",
        "OWNER_EMAIL": "admin@triumphantech.com",
        "EMAIL_FROM": "TriumphantTech <hello@notify.triumphantech.com>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "triumph_db_staging",
          "database_id": "97244bca-414e-4cd1-b1d2-492f9c0b5c5f",
          "migrations_dir": "migrations",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
