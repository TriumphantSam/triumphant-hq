{
  "git": { "deploymentEnabled": false },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.triumphantech.com" }],
      "destination": "https://triumphantech.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "triumphanthq.com" }],
      "destination": "https://triumphantech.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.triumphanthq.com" }],
      "destination": "https://triumphantech.com/$1",
      "statusCode": 301
    }
  ]
}
