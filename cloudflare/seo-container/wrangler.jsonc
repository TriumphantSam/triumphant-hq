{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "triumphant-hq-seo",
  "account_id": "a9bf344e401d603c114b152f500e6722",
  "main": "worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{ "class_name": "SeoScanner", "image": "./Dockerfile", "instance_type": "lite", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "SEO_CONTAINER", "class_name": "SeoScanner" }] },
  "exports": { "SeoScanner": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": true }
}
